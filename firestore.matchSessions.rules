// -----------------------------------------------------------------------------
// MERGE THIS BLOCK into the project's existing firestore.rules.
//
// It is deliberately NOT named `firestore.rules`, so that deploying it whole
// cannot wipe out the rules the iOS app already relies on for users / couples /
// places / collections / upcoming.
//
// Everything the server writes goes through firebase-admin, which bypasses
// rules entirely. So these rules only need to describe what a *client* may do,
// which is exactly two things: read a session it belongs to, and record its own
// swipes and heartbeat.
// -----------------------------------------------------------------------------

match /matchSessions/{sessionId} {

  function isParticipant() {
    return request.auth != null
        && request.auth.uid in resource.data.participants;
  }

  function changedKeys() {
    return request.resource.data.diff(resource.data).affectedKeys();
  }

  // A partner may only touch their own entry in the swipes map.
  function onlyOwnSwipes() {
    return request.resource.data.swipes
             .diff(resource.data.swipes)
             .affectedKeys()
             .hasOnly([request.auth.uid]);
  }

  // A partner may only refresh their own `lastSeenAt` heartbeat — not their
  // `ready` flag, and never the other partner's entry.
  function onlyOwnHeartbeat() {
    return request.resource.data.members
             .diff(resource.data.members)
             .affectedKeys()
             .hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid]
             .diff(resource.data.members[request.auth.uid])
             .affectedKeys()
             .hasOnly(['lastSeenAt']);
  }

  allow read: if isParticipant();

  // Sessions are created, advanced and torn down by the server only.
  allow create, delete: if false;

  allow update: if isParticipant()
    // Status transitions are the server's job; a client cannot skip ahead.
    && request.resource.data.status == resource.data.status
    && request.resource.data.version == resource.data.version
    && changedKeys().hasOnly(['swipes', 'members', 'updatedAt'])
    && (!changedKeys().hasAny(['swipes']) || onlyOwnSwipes())
    && (!changedKeys().hasAny(['members']) || onlyOwnHeartbeat());
}

// The server writes `activeSessionId` onto the couple document so the partner's
// existing couple listener pulls them into a session without any push. Clients
// must not be able to forge that pointer — if the existing rules allow partners
// to update their couple document, add this guard to that rule:
//
//   && !request.resource.data.diff(resource.data)
//         .affectedKeys().hasAny(['activeSessionId'])
