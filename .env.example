# Local server port (Vercel ignores this).
PORT=3000

# Set to PROD on Vercel so error responses stop leaking stack traces.
ENVIROMENT=DEV

# Firebase service account (Project settings -> Service accounts -> Generate key).
# On Vercel, paste the private key with literal \n escapes, exactly as below.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# --- Decide with Partner tuning (all optional, defaults shown) ---
DECK_SIZE=6
SESSION_TTL_MINUTES=30
PRESENCE_WINDOW_SECONDS=45
CANDIDATE_READ_LIMIT=300
DEFAULT_RADIUS_KM=15
NUDGE_COOLDOWN_SECONDS=60
